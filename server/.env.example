# Copie para .env — este arquivo NUNCA deve ser enviado ao Git.
PORT=8787
# Origens autorizadas a chamar a API (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# OpenAI — usada apenas no servidor
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=cedar

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave de serviço: somente no servidor, nunca no frontend
SUPABASE_SERVICE_ROLE_KEY=

# E-mail autorizado (assistente pessoal: um único dono)
OWNER_EMAIL=
