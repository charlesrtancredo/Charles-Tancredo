# Copie para .env — este arquivo NUNCA deve ser enviado ao Git.
PORT=8787
# Origens autorizadas a chamar a API (separadas por vírgula).
# Inclua a URL do GitHub Pages se usar o frontend hospedado lá.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://charlesrtancredo.github.io

# Autenticação pessoal: código secreto (mín. 12 caracteres) digitado uma vez no app.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ACCESS_CODE=
OWNER_NAME=Charles

# OpenAI — usada apenas no servidor
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=cedar
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Supabase (fase 4)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave de serviço: somente no servidor, nunca no frontend
SUPABASE_SERVICE_ROLE_KEY=
OWNER_EMAIL=
